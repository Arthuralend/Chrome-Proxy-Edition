{
  "name": "chrome-proxy-edition",
  "productName": "Chrome Proxy Edition",
  "version": "0.2.0",
  "description": "Chromium browser with an integrated AnyTLS connection",
  "license": "GPL-3.0-only",
  "author": "Chrome Proxy Edition contributors",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron scripts/smoke.cjs",
    "engine": "python3 scripts/fetch-sing-box.py",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.mierubrowser.desktop",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "resources/sing-box/${os}-${arch}",
        "to": "sing-box",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/SING-BOX-LICENSE.txt",
        "to": "SING-BOX-LICENSE.txt"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "Chrome-Proxy-Edition-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/sing-box/sing-box"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  }
}
